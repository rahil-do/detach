<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="WidgetPaymentCell5">
        <item name="android:layout_width">0dp</item><item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item><item name="android:layout_rowWeight">1</item>
        <item name="android:gravity">center</item><item name="android:orientation">vertical</item>
    </style>
    <style name="WidgetPaymentIcon5"><item name="android:layout_width">46dp</item><item name="android:layout_height">46dp</item></style>
    <style name="WidgetPaymentLabel5">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item><item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item><item name="android:textColor">@color/ink</item><item name="android:textSize">10sp</item>
    </style>
    <style name="Theme.Detach" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorPrimaryDark">@color/window</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/secondary_ink</item>
        <item name="android:textColorTertiary">@color/secondary_ink</item>
        <item name="android:textColorHint">@color/secondary_ink</item>
        <item name="android:textColorLink">@color/accent</item>
        <item name="android:colorControlNormal">@color/control_outline</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:colorControlHighlight">@color/press</item>
        <item name="android:colorButtonNormal">@color/surface</item>
        <item name="android:colorError">@color/error</item>
        <item name="android:alertDialogTheme">@style/Theme.Detach.AlertDialog</item>
        <item name="android:colorBackground">@color/window</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/window</item>
        <item name="android:statusBarColor">@color/window</item>
        <item name="android:navigationBarColor">@color/window</item>
    </style>
    <style name="Theme.Detach.AlertDialog" parent="android:Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorPrimary">@color/accent</item>
        <item name="android:colorPrimaryDark">@color/window</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/ink</item>
        <item name="android:textColorSecondary">@color/secondary_ink</item>
        <item name="android:textColorTertiary">@color/secondary_ink</item>
        <item name="android:textColorHint">@color/secondary_ink</item>
        <item name="android:textColorLink">@color/accent</item>
        <item name="android:colorControlNormal">@color/control_outline</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:colorControlHighlight">@color/press</item>
        <item name="android:colorButtonNormal">@color/surface</item>
        <item name="android:colorError">@color/error</item>
        <item name="android:colorBackground">@color/window</item>
        <item name="android:windowBackground">@color/window</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="Theme.Detach.Dialog" parent="Theme.Detach.AlertDialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:alertDialogTheme">@style/Theme.Detach.AlertDialog</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
        <item name="android:windowMinWidthMajor">0dp</item>
        <item name="android:windowMinWidthMinor">0dp</item>
    </style>
    <style name="Theme.Detach.PaymentLaunch" parent="Theme.Detach">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
