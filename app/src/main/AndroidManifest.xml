<?xml version="1.0" encoding="utf-8"?>
<!--
  Detach deliberately requests NO internet permission: it cannot send anything anywhere.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Fingerprint as an alternative to the Detach password. -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <!-- Only to finish a "pause for payments" that a reboot interrupted. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
      Optional, and never granted by installing: the owner grants it once over adb. Used for one
      thing only: putting Detach's own service back in the list of enabled accessibility
      services after a pause.
    -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!--
      Optional special access, granted by the owner (Settings > Usage access, or adb). Used only
      during a pause, to notice Instagram or YouTube being opened and end the pause early.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- The short-lived watcher that runs during a pause. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Detach">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Unlock window shown from the "Detach is protected" panel. Not reachable by other apps. -->
        <activity
            android:name=".UnlockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.Dialog.NoActionBar"
            android:windowSoftInputMode="stateVisible" />

        <!-- "Pause for payments" confirmation, opened from Detach's own notification. Not reachable by other apps. -->
        <activity
            android:name=".PauseActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.DeviceDefault.Dialog.NoActionBar" />

        <!--
          Ends a pause: Detach's own alarm and notification (explicit intents), and Android's
          boot / app-updated broadcasts. Not exported, so no other app can send to it.
        -->
        <receiver
            android:name=".PauseReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Runs only during a pause; ends it early when Instagram or YouTube is opened. -->
        <service
            android:name=".PauseWatchService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Watches for Instagram or YouTube being opened during a user-started pause of a few minutes, to end the pause" />
        </service>

        <service
            android:name=".DetachService"
            android:exported="false"
            android:label="@string/service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>
    </application>
</manifest>
